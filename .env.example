# Database Configuration Template
# Copy this file to .env and modify as needed

# PostgreSQL
POSTGRES_DB=testdb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# MySQL 8
MYSQL8_ROOT_PASSWORD=root
MYSQL8_DATABASE=testdb
MYSQL8_USER=mysql
MYSQL8_PASSWORD=mysql

# MySQL 5.7
MYSQL57_ROOT_PASSWORD=root
MYSQL57_DATABASE=testdb
MYSQL57_USER=mysql
MYSQL57_PASSWORD=mysql

# MariaDB
MARIADB_ROOT_PASSWORD=root
MARIADB_DATABASE=testdb
MARIADB_USER=mariadb
MARIADB_PASSWORD=mariadb

# MS SQL Server
MSSQL_SA_PASSWORD=YourStrong@Passw0rd

# Oracle
ORACLE_PASSWORD=oracle
ORACLE_DATABASE=testdb

# MongoDB
MONGO_INITDB_ROOT_USERNAME=mongo
MONGO_INITDB_ROOT_PASSWORD=mongo
MONGO_INITDB_DATABASE=testdb

# Redis
REDIS_PASSWORD=redis

# Neo4j
NEO4J_AUTH=neo4j/neo4jpassword

# ArangoDB
ARANGO_ROOT_PASSWORD=arango

# ClickHouse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# InfluxDB
INFLUXDB_USERNAME=influx
INFLUXDB_PASSWORD=influxpassword
INFLUXDB_ORG=testorg
INFLUXDB_BUCKET=testbucket
INFLUXDB_TOKEN=influxtoken123

# NeonDB
NEON_USER=neon
NEON_PASSWORD=neon

# Management Tools
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
